 def __init__(self,pack=None,lam=None,a=3,c=17,steer_every=STEER_EVERY,steps=96,alpha=ALPHA,b_tool=BETA_TOOL,b_adv=BETA_ADV,b_tone=BETA_TONE,store=None,manifold=None):
