 t=re.sub(r"\bto\s+the\s+power\s+of\b","**",t,flags=re.I)
 t=re.sub(r"\bdivided\s+by\b|\bover\b","/",t,flags=re.I)
 t=re.sub(r"\bmultiplied\s+by\b|\btimes\b","*",t,flags=re.I)
 t=re.sub(r"\bplus\b","+",t,flags=re.I)
 t=re.sub(r"\bminus\b","-",t,flags=re.I)
 t=re.sub(r"\bsquared\b","** 2",t,flags=re.I)
 t=re.sub(r"\bcubed\b","** 3",t,flags=re.I)
 t=re.sub(r"\b(?:square\s+root\s+of|sqrt\s+of|sqrt)\s+(\d+(?:\.\d+)?)",r"sqrt(\1)",t,flags=re.I)
 t=re.sub(r"\b(sin|cos|tan|log|abs)\s+(?:of\s+)?(\d+(?:\.\d+)?)",r"\1(\2)",t,flags=re.I)
 t=t.replace("^","**")
 if not any(c.isdigit() for c in t):return None
 try:
  tree=ast.parse(t,mode="eval")
  for node in ast.walk(tree):
   if isinstance(node,(ast.Expression,ast.BinOp,ast.UnaryOp,ast.Constant,ast.Call,ast.Name,ast.Load,ast.operator,ast.unaryop)):
    if isinstance(node,ast.Name) and node.id not in MATH_ENV:return None
   else:return None
  val=eval(compile(tree,"<math>","eval"),{"__builtins__":None},MATH_ENV)
  if isinstance(val,(int,float)):
   if isinstance(val,float) and val.is_integer():val=int(val)
   return t,val
 except Exception:return None
