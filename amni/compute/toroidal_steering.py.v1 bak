    verdict="MISS"
    score=0
    tool=False
    sb_ok=False
   return {
    "text":shown,"tape":[],"th":0.0,"ph":0.0,"St":1,"v":[0.0,0.0,1.0],
    "latency_ms":dt,"steps":nwalk,"steering":[],"tool_ok":tool,"n_crash":0,
    "thread_names":{"adv":"adv","tool":"tool","tone":"tone"},
    "final_text":shown,"target_domain":"t2s2","implicit_goal":"CODE_SYNTHESIS",
