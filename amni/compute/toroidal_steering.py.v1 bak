    out=res.get("patched_code") or clean_code
    return {"text":out,"final_text":out,"target_domain":"code","implicit_goal":"DEBUG","speech_act":"DEBUG_PATCH","congruent":True,"latency_ms":(time.perf_counter()-t0)*1000.0,"critic_score":100,"critic_verdict":"VERIFIED","tool_ok":True,"rearms_triggered":0,"steps":0,"total_latency_ms":(time.perf_counter()-t0)*1000.0,"cot_action":None,"persona":"Rikku","candidate_draft":out,"manifold":getattr(self.manifold,"source","?"),"n_ptex":int(getattr(self.manifold,"n_ptex",0)),"walk_closed":True}
  if mode in ("greeting","status"):
