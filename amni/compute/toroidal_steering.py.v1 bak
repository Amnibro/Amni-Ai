   dt=(time.perf_counter()-t0)*1000.0
   if rec.get("code"):
    fence=rec.get("lang") or lang_domain(norm["normalized"],norm["anchors"])
    if fence not in ("python","rust","cpp","fortran","zig"):fence="python"
    shown="```%s\n%s\n```"%(fence,rec["code"].strip())
    tool=bool(rec.get("parse_ok"))
    sb_ok=bool(rec.get("ok"))
