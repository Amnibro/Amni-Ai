def _function_has_guard_on(fn:ast.FunctionDef,names:set)->bool:
 for n in ast.walk(fn):
  if isinstance(n,ast.If):
   if _names_in(n.test)&names:return True
  if isinstance(n,ast.IfExp) and (_names_in(n.test)&names):return True
