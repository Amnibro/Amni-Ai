   else:
    bt,th,ph,St=step(th,ph,St,self.lam,self.a,self.c,greedy=greedy,use_magnetic=True,v_prev=v_prev,dt=0.12)
   tape.append(int(bt)&255)
   _push_delim(stack,bt)
   v_prev=_unit(ray(th,ph))
   walked+=1
   if _colon_newline(tape):indent_pending=4
   cell=hit_cell(v_prev)
