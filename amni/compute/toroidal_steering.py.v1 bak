   v_prev,tr=self.steer_once(seed,tape,v_prev,mode=mode,topic_centroid=topic_centroid)
   traces.append({"t":-1,"cell":int(hit_cell(v_prev)),"gf17":gf17_fold(hit_cell(v_prev)),**tr})
   if (not stack) and _try_ast_strict(bytes(seed).decode("utf-8","replace")) is not None:
