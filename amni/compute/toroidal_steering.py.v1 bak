   goal="GREETING" if mode=="greeting" else "STATUS"
   return {"text":ans,"final_text":ans,"target_domain":"dialogue","implicit_goal":goal,"speech_act":"CONVERSATION","congruent":True,"latency_ms":(time.perf_counter()-t0)*1000.0,"critic_score":100,"critic_verdict":"VERIFIED","tool_ok":True,"rearms_triggered":0,"steps":0,"total_latency_ms":(time.perf_counter()-t0)*1000.0,"cot_action":None,"persona":"Rikku","candidate_draft":ans,"manifold":getattr(self.manifold,"source","?"),"n_ptex":int(getattr(self.manifold,"n_ptex",0)),"walk_closed":True}
  tiles=[]
