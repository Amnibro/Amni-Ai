   if self.manifold is not None and hasattr(self.manifold,"pick_byte") and (len(self.manifold.g3) or len(self.manifold.g2) or len(self.manifold.g1)):
    bt=int(self.manifold.pick_byte(tape,v_prev))
    dth,dph=omega_byte(bt)
