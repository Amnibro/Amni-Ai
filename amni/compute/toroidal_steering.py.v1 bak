  if mode=="creative":
   shown=clean_emit if len(clean_emit)>10 else (ans_candidates[0][1] if ans_candidates else (lines[0] if (tiles and lines) else bytes(seed).decode("utf-8","replace")))
  elif ans_candidates:
   shown=ans_candidates[0][1]
  elif clean_emit and len(clean_emit)>=20 and clean_emit[-1] in ".!?" and not clean_emit.startswith(("A.","B.","C.","D.")):
