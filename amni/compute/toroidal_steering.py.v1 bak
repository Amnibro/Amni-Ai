  self.steer_every=max(1,int(steer_every))
  self.steps=int(steps)
  self.alpha=alpha;self.b_tool=b_tool;self.b_adv=b_adv;self.b_tone=b_tone
 def steer_once(self,seed,tape,v,mode="code",topic_centroid=None,math_val=None):
  window=force_tape(seed,tape)
  box={}
  def _adv():
   box["adv"]=(threading.current_thread().name,)+adversary_force(window,self.pack,mode=mode)
  def _tool():
   box["tool"]=(threading.current_thread().name,)+tool_force(window,self.pack,mode=mode,topic_centroid=topic_centroid,math_val=math_val)
  def _tone():
   box["tone"]=(threading.current_thread().name,)+tone_force(window,self.pack,mode=mode)
  ts=[threading.Thread(name="adv",target=_adv),threading.Thread(name="tool",target=_tool),threading.Thread(name="tone",target=_tone)]
  for t in ts:t.start()
  for t in ts:t.join()
  F_adv,m_adv=box["adv"][1],box["adv"][2]
  F_tool,m_tool=box["tool"][1],box["tool"][2]
  F_tone,m_tone=box["tone"][1],box["tone"][2]
  threads={"adv":box["adv"][0],"tool":box["tool"][0],"tone":box["tone"][0]}
  v2=mix_velocity(v,F_tool,F_adv,F_tone,self.alpha,self.b_tool,self.b_adv,self.b_tone)
  return v2,{"adv":m_adv,"tool":m_tool,"tone":m_tone,"thread_names":threads,"F_adv":F_adv.tolist(),"F_tool":F_tool.tolist(),"F_tone":F_tone.tolist(),"window":len(window)}
 def run(self,query:str,steps=None,steer=True,context=None)->dict:
