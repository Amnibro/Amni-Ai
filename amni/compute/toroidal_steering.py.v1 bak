def adversary_force(tape:list,pack,mode:str="code")->tuple:
 F=np.zeros(3,dtype=np.float64)
 meta={"n_crash":0,"cells":[]}
 text=bytes(tape).decode("utf-8","replace")
 if mode=="code" or ("def " in text):
  tree=_try_ast(text)
  if tree is None:return F,meta
  fn=_first_fn(tree)
  scope=fn if fn is not None else tree
  crash=[]
  for n in ast.walk(scope):
   if isinstance(n,ast.BinOp) and isinstance(n.op,(ast.Div,ast.FloorDiv,ast.Mod)):
    rhs_names=_names_in(n.right)
    guarded=isinstance(scope,ast.FunctionDef) and _function_has_guard_on(scope,rhs_names or {""})
    if not guarded:crash.append(int(pack[ord("/")]))
   if isinstance(n,ast.Subscript):
    coll=_names_in(n.value)
    guarded=isinstance(scope,ast.FunctionDef) and _function_has_guard_on(scope,coll)
    if not guarded:crash.append(int(pack[ord("[")]))
   if isinstance(n,ast.FunctionDef):
    rec=any(isinstance(c,ast.Call) and isinstance(c.func,ast.Name) and c.func.id==n.name for c in ast.walk(n))
    has_base=any(isinstance(c,ast.If) for c in n.body) or any(isinstance(c,ast.Return) for c in n.body[:1])
    if rec and not has_base:crash.append(int(pack[ord("r")]))
  meta["n_crash"]=len(crash)
  meta["cells"]=[gf17_fold(c) for c in crash]
  for c in crash:F=F-CENTS[c]
  return _unit(F),meta
 return F,meta
class _GuardDiv(ast.NodeTransformer):
 def visit_BinOp(self,node):
  self.generic_visit(node)
  if isinstance(node.op,(ast.Div,ast.FloorDiv,ast.Mod)):
   return ast.IfExp(test=ast.Compare(left=node.right,ops=[ast.NotEq()],comparators=[ast.Constant(0)]),body=node,orelse=ast.Constant(0))
  return node
 def visit_Subscript(self,node):
  self.generic_visit(node)
  return ast.IfExp(test=ast.Compare(left=ast.Call(func=ast.Name(id="len",ctx=ast.Load()),args=[node.value],keywords=[]),ops=[ast.Gt()],comparators=[ast.Constant(0)]),body=node,orelse=ast.Constant(None))
def _arity_harness(code:str)->str:
 tree=_try_ast(code)
 if tree is None:return "print('NO_FN')"
 fn=_first_fn(tree)
 if fn is None:return "print('NO_FN')"
 args=[a.arg for a in fn.args.args if a.arg!="self"]
 name=fn.name
 calls=[]
 if len(args)==0:calls.append(f"{name}()")
 elif len(args)==1:
  calls.append(f"{name}(0)")
  calls.append(f"{name}([])")
 else:
  z=",".join(["0"]*len(args))
  calls.append(f"{name}({z})")
  calls.append(f"{name}(1,0)" if len(args)==2 else f"{name}({z})")
 return "\n".join(calls)
