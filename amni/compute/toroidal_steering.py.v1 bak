     if co>0:
      if l.endswith("?"):
       if i+1<len(tls):
        nxt=tls[i+1]
        if len(nxt)>=6 and not nxt.startswith(("{","[","```","def ","from ","print(","A.","B.","C.","D.","Answer with","[title]","Reference:")) and "choices" not in nxt:
         ans_candidates.append((co,nxt))
      else:
       if len(l)>=20 and not l.startswith(("{","[","```","def ","from ","print(","A.","B.","C.","D.","[title]","Reference:")) and "choices" not in l:
        ans_candidates.append((co,l))
   if ans_candidates:
    ans_candidates.sort(key=lambda x:x[0],reverse=True)
  clean_emit=re.sub(r"^[a-z0-9]+\.\s*","",emit).strip()
