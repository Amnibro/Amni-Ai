   expr,val=norm["math"]
   ans=f"{expr} = {val}"
   return {"text":ans,"final_text":ans,"target_domain":"math","implicit_goal":"CALCULATE","speech_act":"CALCULATION","congruent":True,"latency_ms":(time.perf_counter()-t0)*1000.0,"critic_score":100,"critic_verdict":"VERIFIED","tool_ok":True,"rearms_triggered":0,"steps":0,"total_latency_ms":(time.perf_counter()-t0)*1000.0,"cot_action":None,"persona":"Rikku","candidate_draft":ans,"manifold":getattr(self.manifold,"source","?"),"n_ptex":int(getattr(self.manifold,"n_ptex",0)),"walk_closed":True}
  if mode=="code_debug":
   from amni.compute.code_debugger_engine import CodeDebuggerEngine
