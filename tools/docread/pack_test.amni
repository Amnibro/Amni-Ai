		c2[k] = c2[k] ^ 0xFF;
		var o2 byte[>..] = [];
		if pack::pk_bunzip(c2, o2) { okb += 1; }
		c2[k] = c2[k] ^ 0xFF;
	}
	p(str("h1 bz ", okb, " 10"));
	dm::dm_reset("x", "y");
}
