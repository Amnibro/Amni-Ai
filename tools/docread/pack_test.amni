fn fuzz_one(data const byte[:]) int {
	var c = dup(data);
	var tried = 0;
	var k = 0;
	var o byte[>..] = [];
	while k < data.len {
		c[k] = c[k] ^ 0x41;
		let h = pack::pk_tar_open(c);
		if h >= 0 {
			let n = pack::pk_tar_count(h);
			for i in n {
				let ok = pack::pk_tar_read(h, i, o);
			}
			pack::pk_tar_close(h);
		}
		c[k] = c[k] ^ 0x41;
		tried += 1;
		k += 3;
	}
	tried
}
fn case_t8() {
	let a = ld("pk_pax.tar");
	let b = ld("pk_gnu.tar");
	let c = ld("pk_ustar.tar");
	let total = fuzz_one(a) + fuzz_one(b) + fuzz_one(c);
	p(str("t8 fuzz ", total));
}
fn case_h1() {
