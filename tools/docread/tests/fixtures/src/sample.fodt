<office:text>
<text:p text:style-name="Title">Quarterly Garden Report</text:p>
<text:h text:style-name="Heading_20_1" text:outline-level="1">Overview</text:h>
<text:p text:style-name="Standard">The café opened in March. Sales reached 1,250 € in the first week.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">Figures come from the till roll.</text:p></text:note-body></text:note></text:p>
<text:h text:style-name="Heading_20_2" text:outline-level="2">Plans</text:h>
<text:list text:style-name="L1">
<text:list-item><text:p text:style-name="List_20_Paragraph">Plant tulips</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Paragraph">Order soil</text:p>
<text:list><text:list-item><text:p text:style-name="List_20_Paragraph">Peat moss</text:p></text:list-item></text:list>
</text:list-item>
</text:list>
<text:p text:style-name="Standard"><office:annotation><dc:creator>Sam Rivera</dc:creator><dc:date>2026-03-18T09:00:00</dc:date><text:p>Please check these numbers.</text:p></office:annotation>The budget was approved in April.</text:p>
<table:table table:name="Table1">
<table:table-column table:number-columns-repeated="3"/>
<table:table-row>
<table:table-cell office:value-type="string"><text:p>Item</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p>Qty</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p>Price</text:p></table:table-cell>
</table:table-row>
<table:table-row>
<table:table-cell office:value-type="string"><text:p>Tulips</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p>10</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p>5</text:p></table:table-cell>
</table:table-row>
<table:table-row>
<table:table-cell office:value-type="string"><text:p>Soil</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p>4</text:p></table:table-cell>
<table:table-cell office:value-type="string"><text:p>12</text:p></table:table-cell>
</table:table-row>
</table:table>
<text:p text:style-name="Standard">End of report.</text:p>
