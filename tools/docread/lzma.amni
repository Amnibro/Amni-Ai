}
fn lz_run(src const byte[:], out byte[>..]&, size int) bool {
	let base = out.len;
	if size >= 0 && base + size > lz_cap { return lz_over(); }
	while true {
		let done = out.len - base;
		if size >= 0 && done == size { return true; }
		let ps = (out.len - lz_dst) & ((1 << lz_pb) - 1);
		if lz_bit(src, (lz_st << 4) + ps) == 0 {
			if out.len >= lz_cap { return lz_over(); }
			lz_lit(src, out);
		} else {
			let rem = if size >= 0 { size - done } else { 1099511627776 };
			let r = lz_match(src, out, ps, rem);
			if r == 1 { return size < 0 && !lz_bad && lz_code == 0; }
			if r < 0 { return false; }
		}
		if lz_bad { return false; }
	}
	false
}
fn lz_lzma_dec(src const byte[:], props const byte[:], size int, out byte[>..]&) bool {
	lz_capped = false;
	lz_said = false;
	let n = out.len;
	lz_dst = n;
	var ok = false;
	if props.len >= 5 {
		let pb0 int = props[0];
		ok = lz_props(pb0);
	}
	if ok {
		lz_dict = max(lz_le(props, 1, 4), 4096);
		lz_reset(lz_lc, lz_lp, lz_pb);
		ok = lz_rc_init(src, 0, src.len) && lz_run(src, out, size);
		if ok && size >= 0 && lz_code != 0 {
			let ps = (out.len - lz_dst) & ((1 << lz_pb) - 1);
			ok = lz_bit(src, (lz_st << 4) + ps) == 1 && lz_match(src, out, ps, 1) == 1 && !lz_bad && lz_code == 0;
		}
	}
	if ok {
		lz_used = lz_pos;
		return true;
	}
	out.pop_n(out.len - n);
	if !lz_capped { lz_warn("lzma: corrupt or truncated data"); }
	false
}
fn lz_lzma2_run(src const byte[:], start int, eof_ok bool, out byte[>..]&, endp int&) bool {
	var need_dict = true;
	var need_props = true;
	var p = start;
	while true {
		if p >= src.len {
			if eof_ok {
				endp = src.len;
				return true;
			}
			return false;
		}
		let c int = src[p];
		if c == 0 {
			endp = p + 1;
			return true;
		}
		if c >= 224 || c == 1 {
			lz_dst = out.len;
			need_dict = false;
			need_props = true;
		} else if need_dict { return false; }
		if c >= 128 {
			if p + 5 > src.len { return false; }
			let usize = (((c & 31) << 16) | lz_be(src, p + 1, 2)) + 1;
			let csize = lz_be(src, p + 3, 2) + 1;
			var q = p + 5;
			if c >= 192 {
				if q >= src.len { return false; }
				let pbyte int = src[q];
				q += 1;
				if !lz_props(pbyte) || lz_lc + lz_lp > 4 { return false; }
				need_props = false;
				lz_reset(lz_lc, lz_lp, lz_pb);
			} else {
				if need_props { return false; }
				if c >= 160 { lz_reset(lz_lc, lz_lp, lz_pb); }
			}
			if q + csize > src.len { return false; }
			if !lz_rc_init(src, q, q + csize) { return false; }
			if !lz_run(src, out, usize) { return false; }
			if lz_pos != q + csize || lz_code != 0 { return false; }
			p = q + csize;
		} else if c <= 2 {
			if p + 3 > src.len { return false; }
			let usize = lz_be(src, p + 1, 2) + 1;
			if p + 3 + usize > src.len { return false; }
			if out.len + usize > lz_cap {
				lz_over();
				return false;
			}
			out.append(src[p + 3..p + 3 + usize]);
			p += 3 + usize;
		} else {
			return false;
		}
	}
	false
}
fn lz_lzma2_dec(src const byte[:], prop int, out byte[>..]&) bool {
	lz_capped = false;
	lz_said = false;
	let n = out.len;
	var ok = prop >= 0 && prop <= 40;
	var e = 0;
	if ok {
		lz_dict = lz_dsize(prop);
		ok = lz_lzma2_run(src, 0, true, out, e);
	}
	if ok {
		lz_used = e;
		return true;
	}
	out.pop_n(out.len - n);
	if !lz_capped { lz_warn("lzma2: corrupt or truncated data"); }
	false
}
fn lz_x86(buf byte[>..]&, start int, ip int) {
	let n = buf.len - start;
	if n < 5 { return; }
	let allowed bool[8] = [true, true, true, false, true, false, false, false];
	let bitnum int[8] = [0, 1, 2, 2, 3, 3, 3, 3];
	var prev_mask = 0;
	var prev_pos = 4294967291;
	if ((ip - prev_pos) & 0xFFFFFFFF) > 5 { prev_pos = (ip - 5) & 0xFFFFFFFF; }
	let limit = n - 5;
	var i = 0;
	while i <= limit {
		var b int = buf[start + i];
		if b != 0xE8 && b != 0xE9 {
			i += 1;
			continue;
		}
		let offset = (ip + i - prev_pos) & 0xFFFFFFFF;
		prev_pos = (ip + i) & 0xFFFFFFFF;
		if offset > 5 {
			prev_mask = 0;
		} else {
			for rep in offset { prev_mask = (prev_mask & 0x77) << 1; }
		}
		b = buf[start + i + 4];
		if (b == 0 || b == 255) && allowed[(prev_mask >> 1) & 7] && (prev_mask >> 1) < 16 {
			var src = lz_le(buf, start + i + 1, 4);
			var dest = 0;
			while true {
				dest = (src - (ip + i + 5)) & 0xFFFFFFFF;
				if prev_mask == 0 { break; }
				let k = bitnum[(prev_mask >> 1) & 7];
				b = (dest >> (24 - k * 8)) & 255;
				if !(b == 0 || b == 255) { break; }
				src = dest ^ ((1 << (32 - k * 8)) - 1);
			}
			buf[start + i + 4] = if (dest & 0x1000000) != 0 { 255 } else { 0 };
			buf[start + i + 3] = ((dest >> 16) & 255) as byte;
			buf[start + i + 2] = ((dest >> 8) & 255) as byte;
			buf[start + i + 1] = (dest & 255) as byte;
			i += 5;
			prev_mask = 0;
		} else {
			i += 1;
			prev_mask = prev_mask | 1;
			if b == 0 || b == 255 { prev_mask = prev_mask | 16; }
		}
	}
}
fn lz_delta(buf byte[>..]&, start int, dist int) {
	var j = start + dist;
	while j < buf.len {
		let a int = buf[j];
		let c int = buf[j - dist];
		buf[j] = ((a + c) & 255) as byte;
		j++;
	}
}
fn lz_is_xz(d const byte[:]) bool {
	if d.len < 12 { return false; }
	d[0] == 0xFD && d[1] == 0x37 && d[2] == 0x7A && d[3] == 0x58 && d[4] == 0x5A && d[5] == 0
}
fn lz_varint(d const byte[:], p int&, lim int) int {
	var r = 0;
	var i = 0;
	while true {
		if p >= lim || p >= d.len { return -1; }
		if i >= 9 { return -1; }
		let b int = d[p];
		p += 1;
		r = r | ((b & 127) << (7 * i));
		if b < 128 {
			if b == 0 && i > 0 { return -1; }
			return r;
		}
		i += 1;
	}
	-1
}
fn lz_chk_size(t int) int {
	if t == 0 { return 0; }
	if t <= 3 { return 4; }
	if t <= 6 { return 8; }
	if t <= 9 { return 16; }
	if t <= 12 { return 32; }
	if t <= 15 { return 64; }
	-1
}
fn lz_check(t int, d const byte[:], p int, data const byte[:]) bool {
	if t == 1 { return lz_le(d, p, 4) == pack::pk_crc32(data, 0); }
	if t == 4 { return lz_le64(d, p) == lz_crc64(data, 0); }
	if t == 10 {
		let h = crypto::sha256(data);
		for i in 32 {
			if d[p + i] != h[i] { return false; }
		}
		return true;
	}
	true
}
var lz_recu int[>..];
var lz_recs int[>..];
var lz_fid int[>..];
var lz_fpr int[>..];
fn lz_xz_block(d const byte[:], p int, t int, out byte[>..]&, upad int&, usz int&, endp int&) bool {
	if p >= d.len { return false; }
	let hb int = d[p];
	let hs = (hb + 1) * 4;
	if p + hs > d.len { return false; }
	if lz_le(d, p + hs - 4, 4) != pack::pk_crc32(d[p..p + hs - 4], 0) {
		lz_warn("xz: header CRC mismatch");
		return false;
	}
	let flags int = d[p + 1];
	let nf = (flags & 3) + 1;
	if (flags & 0x3C) != 0 { return false; }
	var q = p + 2;
	let hend = p + hs - 4;
	var csz = -1;
	if (flags & 0x40) != 0 {
		csz = lz_varint(d, q, hend);
		if csz < 0 { return false; }
	}
	var hus = -1;
	if (flags & 0x80) != 0 {
		hus = lz_varint(d, q, hend);
		if hus < 0 { return false; }
	}
	lz_fid.clear();
	lz_fpr.clear();
	for i in nf {
		let id = lz_varint(d, q, hend);
		let psz = lz_varint(d, q, hend);
		if id < 0 || psz < 0 || q + psz > hend { return false; }
		var pv = -1;
		if psz == 1 {
			pv = d[q];
		} else if psz == 4 {
			pv = lz_le(d, q, 4);
		}
		let last = i == nf - 1;
		if id == 0x21 {
			if !last || psz != 1 || pv > 40 { return false; }
		} else if id == 3 {
			if last || psz != 1 { return false; }
		} else if id == 4 {
			if last || (psz != 0 && psz != 4) { return false; }
		} else {
			lz_warn("xz: unsupported filter");
			return false;
		}
		lz_fid.push(id);
		lz_fpr.push(pv);
		q += psz;
	}
	for k in q..hend {
		if d[k] != 0 { return false; }
	}
	if hus >= 0 && out.len + hus > lz_cap {
		lz_over();
		return false;
	}
	lz_dict = lz_dsize(lz_fpr[nf - 1]);
	let bstart = out.len;
	let ds = p + hs;
	var e = 0;
	if !lz_lzma2_run(d, ds, false, out, e) { return false; }
	if csz >= 0 && csz != e - ds { return false; }
	usz = out.len - bstart;
	if hus >= 0 && hus != usz { return false; }
	var fi = nf - 2;
	while fi >= 0 {
		let id = lz_fid[fi];
		let pv = lz_fpr[fi];
		if id == 3 {
			lz_delta(out, bstart, pv + 1);
		} else {
			lz_x86(out, bstart, if pv == -1 { 0 } else { pv });
		}
		fi--;
	}
	let npad = (4 - (e - p) % 4) % 4;
	if e + npad > d.len { return false; }
	for k in npad {
		if d[e + k] != 0 { return false; }
	}
	let csize = e - ds;
	e += npad;
	let cs = lz_chk_size(t);
	if cs < 0 || e + cs > d.len { return false; }
	if !lz_check(t, d, e, out[bstart..]) {
		lz_warn("xz: CRC mismatch");
		return false;
	}
	endp = e + cs;
	upad = hs + csize + cs;
	true
}
fn lz_xz_stream(d const byte[:], p int, out byte[>..]&, endp int&) bool {
	if p + 12 > d.len { return false; }
	if !lz_is_xz(d[p..]) { return false; }
	if d[p + 6] != 0 || d[p + 7] >= 16 { return false; }
	let t int = d[p + 7];
	if lz_le(d, p + 8, 4) != pack::pk_crc32(d[p + 6..p + 8], 0) {
		lz_warn("xz: header CRC mismatch");
		return false;
	}
	lz_recu.clear();
	lz_recs.clear();
	var q = p + 12;
	while true {
		if q >= d.len { return false; }
		if d[q] == 0 { break; }
		var up = 0;
		var us = 0;
		var e = 0;
		if !lz_xz_block(d, q, t, out, up, us, e) { return false; }
		lz_recu.push(up);
		lz_recs.push(us);
		q = e;
	}
	let i0 = q;
	var r = q + 1;
	let cnt = lz_varint(d, r, d.len);
	if cnt != lz_recu.len { return false; }
	for k in cnt {
		let a = lz_varint(d, r, d.len);
		let b = lz_varint(d, r, d.len);
		if a != lz_recu[k] || b != lz_recs[k] { return false; }
	}
	while (r - i0) % 4 != 0 {
		if r >= d.len || d[r] != 0 { return false; }
		r += 1;
	}
	if r + 4 > d.len { return false; }
	if lz_le(d, r, 4) != pack::pk_crc32(d[i0..r], 0) { return false; }
	q = r + 4;
	let isz = q - i0;
	if q + 12 > d.len { return false; }
	if lz_le(d, q, 4) != pack::pk_crc32(d[q + 4..q + 10], 0) { return false; }
	if (lz_le(d, q + 4, 4) + 1) * 4 != isz { return false; }
	if d[q + 8] != d[p + 6] || d[q + 9] != d[p + 7] { return false; }
	if d[q + 10] != 0x59 || d[q + 11] != 0x5A { return false; }
	endp = q + 12;
	true
}
fn lz_xz_fail(out byte[>..]&) bool {
	out.clear();
	if !lz_capped && !lz_said { lz_warn("xz: corrupt or truncated data"); }
	false
}
fn lz_unxz(d const byte[:], out byte[>..]&) bool {
	out.clear();
	lz_capped = false;
	lz_said = false;
	if !lz_is_xz(d) {
		lz_warn("xz: not an xz file");
		return false;
	}
	var p = 0;
	while true {
		var e = 0;
		if !lz_xz_stream(d, p, out, e) { return lz_xz_fail(out); }
		p = e;
		let s = p;
		while p < d.len && d[p] == 0 { p += 1; }
		if (p - s) % 4 != 0 { return lz_xz_fail(out); }
		if p >= d.len { break; }
		if d.len - p >= 12 && lz_is_xz(d[p..]) { continue; }
		lz_warn("xz: trailing bytes ignored");
		break;
	}
	true
}
fn lz_is_lzma(d const byte[:]) bool {
	if d.len < 18 { return false; }
	if d[0] >= 225 { return false; }
	let ds = lz_le(d, 1, 4);
	var ok = ds == 4294967295;
	for n in 32 {
		if ds == (1 << n) { ok = true; }
		if n < 31 && ds == 3 * (1 << n) { ok = true; }
	}
	if !ok { return false; }
	var allff = true;
	for i in 8 {
		if d[5 + i] != 0xFF { allff = false; }
	}
	if !allff {
		let us = lz_le(d, 5, 8);
		if us < 0 || us >= 274877906944 { return false; }
	}
	d[13] == 0
}
fn lz_unlzma(d const byte[:], out byte[>..]&) bool {
	out.clear();
	lz_capped = false;
	lz_said = false;
	if !lz_is_lzma(d) {
		lz_warn("lzma: not an lzma file");
		return false;
	}
	var size = -1;
	var allff = true;
	for i in 8 {
		if d[5 + i] != 0xFF { allff = false; }
	}
	if !allff { size = lz_le(d, 5, 8); }
	if !lz_lzma_dec(d[13..], d[0..5], size, out) {
		out.clear();
		return false;
	}
	true
}
