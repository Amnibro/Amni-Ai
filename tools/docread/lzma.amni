import pack;
import crypto.hash;
namespace lzma;

var lz_cap = 268435456;
var lz_capped = false;
var lz_said = false;
fn lz_warn(msg const byte[:]) {
	lz_said = true;
	dm::dm_warn_add(msg);
}
fn lz_over() bool {
	lz_capped = true;
	lz_warn("decompressed data passes the limit of 256 MiB");
	false
}
fn lz_le(s const byte[:], p int, n int) int {
	if p < 0 || p + n > s.len { return -1; }
	if n == 8 && s[p + 7] >= 128 { return -1; }
	var r = 0;
	var i = n - 1;
	while i >= 0 {
		let b int = s[p + i];
		r = (r << 8) | b;
		i--;
	}
	r
}
var lz_c64 u64[>..];
fn lz_crc_init() {
	if lz_c64.len > 0 { return; }
	for n in 256 {
		var c u64 = n as u64;
		for k in 8 {
			if (c & 1) != 0 { c = (c >> 1) ^ 0xC96C5795D7870F42; } else { c = c >> 1; }
		}
		lz_c64.push(c);
	}
}
fn lz_crc64(s const byte[:], crc u64) u64 {
	lz_crc_init();
	var c u64 = crc ^ 0xFFFFFFFFFFFFFFFF;
	for b in s {
		let x u64 = b as u64;
		let idx int = ((c ^ x) & 255) as int;
		c = lz_c64[idx] ^ (c >> 8);
	}
	c ^ 0xFFFFFFFFFFFFFFFF
}
fn lz_le64(s const byte[:], p int) u64 {
	var r u64 = 0;
	var i = 7;
	while i >= 0 {
		let x u64 = s[p + i] as u64;
		r = (r << 8) | x;
		i--;
	}
	r
}
var lz_pos = 0;
var lz_lim = 0;
var lz_rng = 0;
var lz_code = 0;
var lz_bad = false;
var lz_pr int[>..];
let LZ_ISREP = 192;
let LZ_REPG0 = 204;
let LZ_REPG1 = 216;
let LZ_REPG2 = 228;
let LZ_REP0L = 240;
let LZ_SLOT = 432;
let LZ_SPEC = 688;
let LZ_ALIGN = 803;
let LZ_LEN = 819;
let LZ_RLEN = 1333;
let LZ_LIT = 1847;
var lz_lc = 0;
var lz_lp = 0;
var lz_pb = 0;
var lz_st = 0;
var lz_r0 = 0;
var lz_r1 = 0;
var lz_r2 = 0;
var lz_r3 = 0;
var lz_dst = 0;
var lz_dict = 4294967295;
var lz_used = 0;
fn lz_dsize(prop int) int {
	if prop == 40 { return 4294967295; }
	(2 | (prop & 1)) << ((prop >> 1) + 11)
}
fn lz_props(b int) bool {
	if b >= 225 { return false; }
	lz_lc = b % 9;
	lz_lp = (b / 9) % 5;
	lz_pb = b / 45;
	true
}
fn lz_reset(lc int, lp int, pb int) {
	lz_lc = lc;
	lz_lp = lp;
	lz_pb = pb;
	lz_pr.clear();
	let n = LZ_LIT + (768 << (lc + lp));
	while lz_pr.len < n { lz_pr.push(1024); }
	lz_st = 0;
	lz_r0 = 0;
	lz_r1 = 0;
	lz_r2 = 0;
	lz_r3 = 0;
}
fn lz_be(s const byte[:], p int, n int) int {
	var r = 0;
	for i in n {
		let b int = s[p + i];
		r = (r << 8) | b;
	}
	r
}
fn lz_rc_init(src const byte[:], p int, lim int) bool {
	lz_pos = p + 5;
	lz_lim = lim;
	lz_bad = false;
	lz_rng = 0xFFFFFFFF;
	lz_code = 0;
	if p + 5 > lim || p + 5 > src.len { return false; }
	if src[p] != 0 { return false; }
	lz_code = lz_be(src, p + 1, 4);
	if lz_code == lz_rng { return false; }
	true
}
fn lz_norm(src const byte[:]) {
	if lz_rng < 16777216 {
		var nb = 0;
		if lz_pos < lz_lim && lz_pos < src.len {
			nb = src[lz_pos];
			lz_pos += 1;
		} else {
			lz_bad = true;
		}
		lz_rng = (lz_rng << 8) & 0xFFFFFFFF;
		lz_code = ((lz_code << 8) | nb) & 0xFFFFFFFF;
	}
}
fn lz_bit(src const byte[:], i int) int {
	let p = lz_pr[i];
	let bound = (lz_rng >> 11) * p;
	var bit = 0;
	if lz_code < bound {
		lz_rng = bound;
		lz_pr[i] = p + ((2048 - p) >> 5);
	} else {
		lz_rng -= bound;
		lz_code -= bound;
		lz_pr[i] = p - (p >> 5);
		bit = 1;
	}
	lz_norm(src);
	bit
}
fn lz_tree(src const byte[:], base int, n int) int {
	var m = 1;
	for i in n { m = (m << 1) | lz_bit(src, base + m); }
	m - (1 << n)
}
fn lz_rtree(src const byte[:], base int, n int) int {
	var m = 1;
	var r = 0;
	for i in n {
		let bit = lz_bit(src, base + m);
		m = (m << 1) | bit;
		r |= bit << i;
	}
	r
}
fn lz_direct(src const byte[:], n int) int {
	var r = 0;
	for i in n {
		lz_rng = lz_rng >> 1;
		var bit = 0;
		if lz_code >= lz_rng {
			lz_code -= lz_rng;
			bit = 1;
		}
		lz_norm(src);
		r = (r << 1) | bit;
	}
	r
}
fn lz_len(src const byte[:], base int, ps int) int {
	if lz_bit(src, base) == 0 { return lz_tree(src, base + 2 + ps * 8, 3); }
	if lz_bit(src, base + 1) == 0 { return 8 + lz_tree(src, base + 130 + ps * 8, 3); }
	16 + lz_tree(src, base + 258, 8)
}
fn lz_dist(src const byte[:], len int) int {
	let ls = min(len, 3);
	let slot = lz_tree(src, LZ_SLOT + ls * 64, 6);
	if slot < 4 { return slot; }
	let nb = (slot >> 1) - 1;
	let d = (2 | (slot & 1)) << nb;
	if slot < 14 {
		let low = lz_rtree(src, LZ_SPEC + d - slot, nb);
		return d + low;
	}
	let hi = lz_direct(src, nb - 4) << 4;
	let lo = lz_rtree(src, LZ_ALIGN, 4);
	d + hi + lo
}
fn lz_lit(src const byte[:], out byte[>..]&) {
	let n = out.len - lz_dst;
	var prev int = 0;
	if n > 0 { prev = out[out.len - 1]; }
	let b = LZ_LIT + 768 * (((n & ((1 << lz_lp) - 1)) << lz_lc) + (prev >> (8 - lz_lc)));
	var sym = 1;
	if lz_st >= 7 {
		if lz_r0 >= n {
			lz_bad = true;
			return;
		}
		var mb int = out[out.len - lz_r0 - 1];
		while sym < 256 {
			let mbit = (mb >> 7) & 1;
			mb = (mb << 1) & 255;
			let bit = lz_bit(src, b + ((1 + mbit) << 8) + sym);
			sym = (sym << 1) | bit;
			if mbit != bit { break; }
		}
	}
	while sym < 256 { sym = (sym << 1) | lz_bit(src, b + sym); }
	out.push((sym - 256) as byte);
	if lz_st < 4 { lz_st = 0; } else if lz_st < 10 { lz_st -= 3; } else { lz_st -= 6; }
}
fn lz_match(src const byte[:], out byte[>..]&, ps int, rem int) int {
	let n = out.len - lz_dst;
	var ln = 0;
	if lz_bit(src, LZ_ISREP + lz_st) == 0 {
		lz_r3 = lz_r2;
		lz_r2 = lz_r1;
		lz_r1 = lz_r0;
		ln = lz_len(src, LZ_LEN, ps);
		lz_st = if lz_st < 7 { 7 } else { 10 };
		lz_r0 = lz_dist(src, ln);
		if lz_r0 == 4294967295 { return 1; }
	} else {
		if n == 0 { return -1; }
		if lz_bit(src, LZ_REPG0 + lz_st) == 0 {
			if lz_bit(src, LZ_REP0L + (lz_st << 4) + ps) == 0 {
				lz_st = if lz_st < 7 { 9 } else { 11 };
				if lz_bad || lz_r0 >= n || lz_r0 >= lz_dict { return -1; }
				if out.len >= lz_cap {
					lz_over();
					return -1;
				}
				let sb byte = out[out.len - lz_r0 - 1];
				out.push(sb);
				return 0;
			}
		} else {
			var d = 0;
			if lz_bit(src, LZ_REPG1 + lz_st) == 0 {
				d = lz_r1;
			} else {
				if lz_bit(src, LZ_REPG2 + lz_st) == 0 {
					d = lz_r2;
				} else {
					d = lz_r3;
					lz_r3 = lz_r2;
				}
				lz_r2 = lz_r1;
			}
			lz_r1 = lz_r0;
			lz_r0 = d;
		}
		ln = lz_len(src, LZ_RLEN, ps);
		lz_st = if lz_st < 7 { 8 } else { 11 };
	}
	let l = ln + 2;
	if lz_bad || lz_r0 >= n || lz_r0 >= lz_dict || l > rem { return -1; }
	if out.len + l > lz_cap {
		lz_over();
		return -1;
	}
	for i in l {
		let cb byte = out[out.len - lz_r0 - 1];
		out.push(cb);
	}
